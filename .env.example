# Database. The server applies migrations from `migrations/` at
# boot. The DB itself must already exist:
#   createdb lursystem
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/lursystem

# AES-256-GCM key for TOTP secret encryption at rest. 32 bytes,
# URL-safe-base64-encoded, no padding. Required whenever any
# user has MFA enabled or the operator opts into
# MfaPolicy::Required.
#
# Generate with:
#   openssl rand 32 | base64 | tr '+/' '-_' | tr -d '='
RUSTIO_SECRET_KEY=
